# ============================================================
# Sathimate — environment variables
# Server par ye file .env.production ke naam se rakhni hai
# (project root mein). Git mein kabhi commit mat karna.
# ============================================================

# ---- Firebase (client SDK) ----
# Ye NEXT_PUBLIC_ wale keys browser mein visible hote hain — ye by design public hain.
# Inki security Firestore rules se aati hai, chhupane se nahi.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# ---- Firebase Admin (server side, /api/nearby) ----
# Service account JSON ko base64 karke yahan paste karo:
#   Linux/Mac : base64 -w0 service-account.json
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# YE SECRET HAI. Kabhi client code ya git mein mat daalna.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---- Maps / AI ----
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# NEXT_PUBLIC_GEMINI_API_KEY browser mein leak hota hai — isko use mat karo,
# AI calls hamesha /api/ route se karo aur server-side GEMINI_API_KEY use karo.

# ---- App ----
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
NEXT_PUBLIC_SITE_URL=https://sathimate.com

# ---- Uploads (Firebase Storage ki jagah, apne VPS par) ----
# Ye folder project folder ke BAHAR hona chahiye, warna deploy par delete ho jayega.
UPLOAD_DIR=/var/www/sathimate-uploads

# ---- Phone OTP login ----
# false/khali = band (free). Blaze plan lene ke baad 'true' karna.
NEXT_PUBLIC_ENABLE_PHONE_AUTH=false
