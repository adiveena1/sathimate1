    "firebase": "^12.11.0",
    "firebase-admin": "^13.4.0",
    "framer-motion": "^11.2.10",
    "geofire-common": "^6.0.0",
    "lucide-react": "^0.475.0",
    "next": "^14.2.35",
    "next-themes": "^0.3.0",
    "patch-package": "^8.0.0",
    "react": "18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.12.7",
